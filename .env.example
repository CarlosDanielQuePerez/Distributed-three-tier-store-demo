# Local demonstration credentials only. Replace before deploying anywhere shared.
MARIADB_ROOT_PASSWORD=change-this-root-password
MARIADB_BACKUP_PASSWORD=change-this-backup-password
CATALOG_DB_NAME=store
CATALOG_DB_USER=store_app
CATALOG_DB_PASSWORD=change-this-catalog-password
MONGO_DB_NAME=store_reviews
MONGO_ROOT_USERNAME=store_admin
MONGO_ROOT_PASSWORD=change-this-mongodb-password
# Usuario de aplicación de MongoDB (readWrite solo en MONGO_DB_NAME). Lo crea catalog-init.
MONGO_APP_USERNAME=store_reviews_app
MONGO_APP_PASSWORD=change-this-mongodb-app-password
NAGIOSADMIN_PASSWORD=change-this-nagios-password
# RabbitMQ (colas de reseñas y caché)
RABBITMQ_USER=store_app
RABBITMQ_PASSWORD=change-this-rabbitmq-password
# Token Bearer para PUT /api/products/{sku}/price. Vacío = endpoint de administración deshabilitado.
API_ADMIN_TOKEN=
# Telemetría (perfil "observability"). Vacío = deshabilitada.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Fallos inyectados en el worker (0.0 - 1.0) para probar reintentos y DLQ.
WORKER_FAILURE_RATE=0
# Corte gradual Compose → K3s (perfil "cutover").
CUTOVER_COMPOSE_WEIGHT=90
CUTOVER_K3S_WEIGHT=10
K3S_INGRESS_ADDR=192.168.1.240:80
K3S_INGRESS_HOST=store.local
