{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "store/review.created/v1",
  "title": "review.created v1",
  "description": "Publicado por la API en store.events con routing key reviews.created. properties.messageId = idempotencyKey.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "idempotencyKey", "occurredAt", "data"],
  "properties": {
    "type": { "const": "review.created" },
    "version": { "const": 1 },
    "idempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sku", "reviewer", "rating", "comment"],
      "properties": {
        "sku": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,32}$" },
        "reviewer": { "type": "string", "minLength": 1, "maxLength": 80 },
        "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
        "comment": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
